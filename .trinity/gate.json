{
  "domains": [
    "notes",
    "editor",
    "preview"
  ],
  "rules": [
    {
      "glob": "src/notes/**",
      "domain": "notes"
    },
    {
      "glob": "src/editor/**",
      "domain": "editor"
    },
    {
      "glob": "src/preview/**",
      "domain": "preview"
    }
  ],
  "spine": [
    "src/shared/**",
    "src/main.ts",
    "index.html",
    "vite.config.ts",
    "vitest.config.ts",
    "tsconfig.json",
    "package.json",
    "pnpm-lock.yaml",
    "eslint.config.js",
    ".prettierrc*"
  ],
  "commands": {
    "scoped": "pnpm vitest run {paths}",
    "full": "pnpm vitest run",
    "check": "pnpm prettier --check . && pnpm eslint . && pnpm tsc --noEmit"
  }
}
